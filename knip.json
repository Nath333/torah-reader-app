{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.js",
    "src/App.js",
    "src/setupTests.js",
    "src/setupProxy.js",
    "public/sw.js",
    "scripts/**/*.js"
  ],
  "project": [
    "src/**/*.{js,jsx}",
    "!src/**/*.test.{js,jsx}",
    "!src/__tests__/**",
    "!src/__mocks__/**"
  ],
  "ignore": [
    "scripts/**",
    "public/**"
  ],
  "ignoreDependencies": [
    "gh-pages"
  ]
}
